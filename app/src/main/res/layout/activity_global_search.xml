<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/searchRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/novelex_bg_dark" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_novelex_topbar" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="14dp">
  <ImageButton android:id="@+id/searchBack" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/ic_novelex_back" android:tint="@color/novelex_text_white" android:contentDescription="@string/ui_41"/>
  <EditText android:id="@+id/globalSearchInput" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_topbar_action" android:drawableStart="@drawable/ic_novelex_search" android:drawableTint="@color/novelex_primary_pink" android:drawablePadding="10dp" android:hint="@string/search_hint_global" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:paddingHorizontal="13dp" android:textColor="@color/novelex_text_white" android:textColorHint="@color/novelex_text_muted" android:textSize="14sp"/>
 </LinearLayout>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/globalSearchResults" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="20dp"/>
</LinearLayout>
