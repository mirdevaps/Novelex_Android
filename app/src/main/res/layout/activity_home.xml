<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/novelex_bg_dark"
    android:orientation="vertical">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/homeTopbar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_novelex_topbar"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="NOVE"
                    android:textColor="@color/novelex_text_white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="LEX"
                    android:textColor="@color/novelex_primary_pink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:letterSpacing="0.04"
                android:text="@string/topbar_tagline"
                android:textColor="@color/novelex_text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeSearch"
            android:layout_width="132dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_topbar_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="11dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription=""
                android:src="@drawable/ic_novelex_search"
                android:tint="@color/novelex_primary_pink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/search_all"
                android:textColor="@color/novelex_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Destaques Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/novelex_primary_pink" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_highlights"
                    android:textColor="@color/novelex_text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_swipe"
                    android:textColor="@color/novelex_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/homeHighlights"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp" />

            <LinearLayout
                android:id="@+id/homeDots"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Continuar Assistindo Carousel Section -->
            <LinearLayout
                android:id="@+id/homeContinueSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/novelex_primary_pink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continuar Assistindo"
                            android:textColor="@color/novelex_text_white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="De onde você parou"
                            android:textColor="@color/novelex_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/homeContinueSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:text="Ver todos"
                        android:textColor="@color/novelex_primary_pink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeContinueList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- Popular / Ranking Section -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:minHeight="360dp"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="16dp" />

            <!-- Native Ad Slot -->
            <include
                android:id="@+id/homeNativeAd"
                layout="@layout/item_home_native_ad"
                android:visibility="gone" />

            <!-- Releases Section -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeReleases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:minHeight="360dp"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation (Como estava antes do Conceito 2) -->
    <LinearLayout
        android:id="@+id/homeBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/novelex_bg_dark"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/homeNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:drawableTop="@drawable/ic_novelex_home"
            android:drawablePadding="3dp"
            android:drawableTint="@color/novelex_primary_pink"
            android:paddingVertical="6dp"
            android:text="@string/home_label"
            android:textColor="@color/novelex_primary_pink"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeNavShorts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_novelex_short_catalog"
            android:drawablePadding="3dp"
            android:drawableTint="@color/novelex_text_muted"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingVertical="6dp"
            android:text="@string/ui_1"
            android:textColor="@color/novelex_text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/homeNavDoramas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_novelex_dorama"
            android:drawablePadding="3dp"
            android:drawableTint="@color/novelex_text_muted"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingVertical="6dp"
            android:text="@string/ui_2"
            android:textColor="@color/novelex_text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/homeNavSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_novelex_bookmark"
            android:drawablePadding="3dp"
            android:drawableTint="@color/novelex_text_muted"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/ui_3"
            android:textColor="@color/novelex_text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/homeNavContinue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_novelex_continue"
            android:drawablePadding="3dp"
            android:drawableTint="@color/novelex_text_muted"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/ui_4"
            android:textColor="@color/novelex_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
