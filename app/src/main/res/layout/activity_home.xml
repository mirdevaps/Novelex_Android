<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/homeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/novelex_bg_dark" android:orientation="vertical">
 <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_novelex_topbar" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVE" android:textColor="@color/novelex_text_white" android:textSize="19sp" android:textStyle="bold" android:letterSpacing="0.05"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEX" android:textColor="@color/novelex_primary_pink" android:textSize="19sp" android:textStyle="bold" android:letterSpacing="0.05"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-2dp" android:text="@string/topbar_tagline" android:textColor="@color/novelex_text_muted" android:textSize="9sp" android:letterSpacing="0.04"/></LinearLayout>
  <LinearLayout android:id="@+id/homeSearch" android:layout_width="132dp" android:layout_height="38dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_topbar_action" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="11dp"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_novelex_search" android:tint="@color/novelex_text_white" android:contentDescription=""/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/search_all" android:textColor="@color/novelex_text_muted" android:textSize="12sp"/></LinearLayout>
 </RelativeLayout>
 <androidx.core.widget.NestedScrollView android:id="@+id/homeScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:overScrollMode="never">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="8dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_highlights" android:textColor="@color/novelex_text_white" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_swipe" android:textColor="@color/novelex_text_muted" android:textSize="11sp"/></LinearLayout>
   <androidx.viewpager2.widget.ViewPager2 android:id="@+id/homeHighlights" android:layout_width="match_parent" android:layout_height="236dp" android:clipToPadding="false" android:paddingHorizontal="16dp"/>
   <LinearLayout android:id="@+id/homeDots" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:orientation="horizontal"/>
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/homeRanking" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="360dp" android:nestedScrollingEnabled="false" android:paddingBottom="16dp" android:clipToPadding="false"/>
   <include android:id="@+id/homeNativeAd" layout="@layout/item_home_native_ad" android:visibility="gone"/>
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/homeReleases" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="360dp" android:nestedScrollingEnabled="false" android:paddingBottom="16dp" android:clipToPadding="false"/>
  </LinearLayout>
 </androidx.core.widget.NestedScrollView>
 <LinearLayout android:id="@+id/homeBottomNavigation" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/novelex_bg_dark" android:elevation="12dp" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingVertical="6dp"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_novelex_home" android:tint="@color/novelex_primary_pink" android:contentDescription=""/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/home_label" android:textColor="@color/novelex_primary_pink" android:textSize="10sp"/></LinearLayout>
  <TextView android:id="@+id/homeNavShorts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/ui_1" android:textSize="10sp" android:maxLines="2" android:drawableTop="@drawable/ic_novelex_short_catalog" android:drawablePadding="3dp" android:paddingVertical="6dp" android:drawableTint="@color/novelex_text_muted" android:textColor="@color/novelex_text_muted" android:clickable="true" android:focusable="true"/>
  <TextView android:id="@+id/homeNavDoramas" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/ui_2" android:textSize="10sp" android:maxLines="2" android:drawableTop="@drawable/ic_novelex_dorama" android:drawablePadding="3dp" android:paddingVertical="6dp" android:drawableTint="@color/novelex_text_muted" android:textColor="@color/novelex_text_muted" android:clickable="true" android:focusable="true"/>
  <TextView android:id="@+id/homeNavSaved" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/ui_3" android:textSize="10sp" android:drawableTop="@drawable/ic_novelex_bookmark" android:drawablePadding="3dp" android:paddingVertical="6dp" android:drawableTint="@color/novelex_text_muted" android:textColor="@color/novelex_text_muted" android:clickable="true" android:focusable="true"/>
  <TextView android:id="@+id/homeNavContinue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/ui_4" android:textSize="10sp" android:drawableTop="@drawable/ic_novelex_continue" android:drawablePadding="3dp" android:paddingVertical="6dp" android:drawableTint="@color/novelex_text_muted" android:textColor="@color/novelex_text_muted" android:clickable="true" android:focusable="true"/>
 </LinearLayout>
</LinearLayout>
