<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#655B6A"
        android:layout_marginBottom="18dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_15" android:textColor="@color/novelex_primary_pink" android:textSize="10sp" android:letterSpacing="0.16" android:textStyle="bold" android:layout_marginBottom="8dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/sheetDramaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_16"
            android:textColor="@color/novelex_text_white"
            android:fontFamily="sans-serif-medium"
            android:textSize="23sp"
            android:maxLines="2" android:ellipsize="end"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetEpisodeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sheetDramaTitle"
            android:text="80 episódios • Assista anúncio para liberar"
            android:textColor="@color/novelex_text_muted"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </RelativeLayout>

    <!-- Espaço para Anúncio Nativo / Banner no Topo da Lista -->
    <FrameLayout
        android:id="@+id/adContainerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search_box"
        android:minHeight="0dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_17" android:textColor="@color/novelex_text_white" android:textSize="14sp" android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheetEpisodesRecyclerView"
        android:layout_width="match_parent"
            android:layout_height="300dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

</LinearLayout>
