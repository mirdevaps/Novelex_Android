<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btnEpisodeGridContainer"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_sheet_episode_button">

    <ImageView android:id="@+id/episodeThumbnail" android:layout_width="64dp" android:layout_height="64dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/btnEpisodeGridItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/episodeThumbnail"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        android:text="1"
        android:textColor="@color/novelex_text_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:importantForAccessibility="no" />

    <TextView android:id="@+id/episodeState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/episodeThumbnail" android:layout_marginStart="14dp" android:layout_alignParentBottom="true" android:layout_marginBottom="14dp" android:gravity="center" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/novelex_text_muted" android:importantForAccessibility="no" />

    <TextView android:id="@+id/episodeRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@id/btnEpisodeGridItem" android:layout_marginStart="24dp" android:layout_marginEnd="36dp" android:layout_centerVertical="true" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/novelex_text_white" />
    <!-- Ícone de Cadeado para Episódios Bloqueados -->
    <ImageView
        android:id="@+id/txtLockIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_novelex_lock"
        android:contentDescription="Episódio bloqueado"
        app:tint="@color/novelex_badge_gold"
        android:visibility="gone" />

    <!-- Ícone de Download Concluído Offline -->
    <TextView
        android:id="@+id/txtDownloadedIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:text="✓"
        android:textColor="#00E676"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
