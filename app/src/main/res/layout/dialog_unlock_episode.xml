<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center_horizontal" android:padding="14dp" android:background="@drawable/bg_player_circle" android:src="@drawable/ic_novelex_lock" android:tint="@color/novelex_primary_pink" android:importantForAccessibility="no" />
 <TextView android:id="@+id/unlockChapter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textColor="@color/novelex_primary_pink" android:textSize="11sp" android:letterSpacing="0.12" android:textStyle="bold" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/ui_10" android:textColor="@color/novelex_text_white" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/ui_11" android:textColor="@color/novelex_text_muted" android:textSize="14sp" android:lineSpacingExtra="4dp" />
 <TextView android:id="@+id/unlockStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textColor="@color/novelex_text_muted" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
 <com.google.android.material.button.MaterialButton android:id="@+id/unlockWatch" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="@string/ui_12" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="@color/novelex_primary_pink" android:textColor="@color/novelex_bg_dark" />
 <com.google.android.material.button.MaterialButton android:id="@+id/unlockClose" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/ui_13" android:textAllCaps="false" android:textColor="@color/novelex_text_muted" />
</LinearLayout>
