# Configuração de assinatura para builds de release do Novelex
# Copie este arquivo para 'keystore.properties' (que é ignorado pelo Git)
# e substitua pelos caminhos e senhas da sua chave de release.

storeFile=/path/to/your/release-key
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password
